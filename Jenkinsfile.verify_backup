pipeline {
    agent any

    triggers {
        cron('H/30 * * * *')
    }

    environment {
        SLACK_WEBHOOK_URL = credentials('slack_webhook_url')
    }

    stages {
        // No offsite storage exists yet — backups currently only live in the
        // postgres_backups Docker volume on this host, written nightly by the
        // celery-worker's create_database_backup task (02:00 UTC). This stage
        // used to look for an Azure Blob upload that nothing has produced since
        // Azure backup support was removed; "not found" was treated as a skip,
        // not a failure, so it silently reported success for months with
        // nothing to verify. Look at the actual local volume instead, and fail
        // the build — not skip it — if nothing recent is there.
        stage('Find Latest Local Backup') {
            steps {
                sh '''
                    rm -f backup.dump

                    # -mmin -1560: modified within the last 26 hours — a bit of buffer over
                    # the 24h nightly cycle without masking a genuinely stuck/broken job.
                    LATEST_DUMP=$(docker exec daily_grocer_celery_worker \
                        find /app/backups -maxdepth 1 -name "*.dump" -mmin -1560 -printf "%T@ %p\\n" \
                        | sort -rn | head -n1 | cut -d' ' -f2)

                    if [ -z "$LATEST_DUMP" ]; then
                        echo "No backup newer than 26 hours found in the postgres_backups volume."
                        echo "The nightly database backup task appears to be stuck or failing."
                        exit 1
                    fi

                    echo "Found recent backup: $LATEST_DUMP"
                    docker cp "daily_grocer_celery_worker:$LATEST_DUMP" "./backup.dump"
                '''
            }
        }

        stage('Verify Structural Integrity') {
            steps {
                sh '''
                    echo 'Spinning up ephemeral PostgreSQL container...'
                    docker run --name pg_verify_tmp -e POSTGRES_PASSWORD=verify -e POSTGRES_DB=verify_db -d postgres:15-alpine

                    echo 'Waiting for PostgreSQL to initialize...'
                    until docker exec pg_verify_tmp pg_isready -U postgres -d verify_db; do
                        sleep 2
                    done

                    echo "Copying backup.dump to container..."
                    docker cp backup.dump pg_verify_tmp:/tmp/backup.dump

                    echo 'Restoring the backup...'
                    docker exec pg_verify_tmp pg_restore -U postgres -d verify_db --clean --if-exists -Fc /tmp/backup.dump

                    echo 'Running structural integrity validation...'
                    docker exec pg_verify_tmp psql -U postgres -d verify_db -c 'SELECT count(*) FROM users;'

                    echo 'Teardown ephemeral container...'
                    docker rm -f pg_verify_tmp
                    rm -f backup.dump

                    echo 'Validation Successful!'
                '''
            }
        }
    }

    post {
        always {
            sh "docker rm -f pg_verify_tmp || true"
        }
        success {
            echo "Backup verification pipeline completed successfully."
        }
        failure {
            echo "Backup verification failed! Sending alert..."
            sh '''
                if [ -n "$SLACK_WEBHOOK_URL" ]; then
                    curl -X POST -H 'Content-type: application/json' --data '{"text":"🚨 DailyGrocer backup verification failed — no recent, restorable local backup found. Check the celery-worker logs for the nightly-database-backup task."}' $SLACK_WEBHOOK_URL || true
                fi
            '''
        }
    }
}
