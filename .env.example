# Database Configuration
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password_change_me
POSTGRES_DB=pos_db

# Backend Configuration
JWT_SECRET_KEY=generate_a_random_hex_string_here
DEBUG=False
CORS_ORIGINS=http://your-vps-ip,http://your-domain.com

# Stripe webhook signature verification — from the Stripe Dashboard's webhook
# endpoint settings once /api/v1/webhooks/stripe is registered there. Leave
# unset in dev; the endpoint refuses to run without it rather than accepting
# unverified requests.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Storefront build-time config — not secrets, but baked into the storefront's
# JS bundle at `docker compose build storefront`, so this is where to set the
# live values before launch rather than editing storefront/src/constants.ts.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_your_stripe_publishable_key

# Ports (Optional if using Nginx defaults)
# FRONTEND_PORT=80
# BACKEND_PORT=8000
